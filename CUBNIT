-- Função para limpar efeitos e restaurar o Lighting original
local function ResetLighting()
    -- Remove objetos de efeito
    for _, obj in pairs(Lighting:GetChildren()) do
        if obj:IsA("PostEffect") or obj:IsA("Sky") or obj:IsA("Atmosphere") then
            obj:Destroy()
        end
    end
    for _, obj in pairs(Terrain:GetChildren()) do
        if obj:IsA("Clouds") then obj:Destroy() end
    end
    
    -- Restaura valores padrão do Roblox
    Lighting.ClockTime = 14
    Lighting.Brightness = 2
    Lighting.Ambient = Color3.fromRGB(127, 127, 127)
    Lighting.OutdoorAmbient = Color3.fromRGB(127, 127, 127)
    Lighting.ExposureCompensation = 0
    Lighting.FogEnd = 100000
    Lighting.GlobalShadows = true
    
    Terrain.WaterColor = Color3.fromRGB(12, 84, 92)
    Terrain.WaterReflectance = 1
    Terrain.WaterTransparency = 0.3
end

-- Função para criar botões estilizados
local function CreateButton(name, color)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.BackgroundColor3 = color or Color3.fromRGB(45, 45, 45)
    btn.BorderSizePixel = 0
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(240, 240, 240)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 14
    btn.Parent = ButtonContainer
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = btn
    
    return btn
end

