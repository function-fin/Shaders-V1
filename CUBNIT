-- 5. FUNÇÕES DE SUPORTE, SISTEMA DE SOL/LUA E RESET TOTAL

if _G.SkyConnections == nil then
    _G.SkyConnections = {}
end

local function TotalReset()
    _G.ShadersActive = false

    for _, conn in pairs(_G.SkyConnections) do
        if conn then conn:Disconnect() end
    end
    _G.SkyConnections = {}

    for _, obj in pairs(Lighting:GetChildren()) do
        if obj:IsA("PostEffect") or obj:IsA("Sky") or obj:IsA("Atmosphere") or obj.Name == "ULTRA_K_ORIGINAL" then
            obj:Destroy()
        end
    end

    if workspace:FindFirstChild("FakeRain") then workspace.FakeRain:Destroy() end

    for _, obj in pairs(Terrain:GetChildren()) do
        if obj:IsA("Clouds") then obj:Destroy() end
    end

    for _, part in pairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Reflectance = 0
        end
    end

    Lighting.ClockTime = 14
    Lighting.Brightness = 2
    Lighting.OutdoorAmbient = Color3.fromRGB(127, 127, 127)
    Lighting.FogEnd = 100000
    Lighting.ExposureCompensation = 0
    Terrain.WaterColor = Color3.fromRGB(12, 84, 92)
    Terrain.WaterReflectance = 1
    Terrain.WaterTransparency = 0.3
end

local function AplicarTexturasSolLua(sky)
    if not sky or not _G.ShadersActive then return end

    if sky.SunTextureId ~= TEXTURA_SOL_LUA then
        sky.SunTextureId = TEXTURA_SOL_LUA
    end
    if sky.MoonTextureId ~= TEXTURA_SOL_LUA then
        sky.MoonTextureId = TEXTURA_SOL_LUA
    end

    if sky.SunAngularSize ~= TAMANHO_SOL_LUA then
        sky.SunAngularSize = TAMANHO_SOL_LUA
    end
    if sky.MoonAngularSize ~= TAMANHO_SOL_LUA then
        sky.MoonAngularSize = TAMANHO_SOL_LUA
    end
end

local function MonitorarSolLua(sky)
    AplicarTexturasSolLua(sky)

    local connSun = sky:GetPropertyChangedSignal("SunTextureId"):Connect(function()
        AplicarTexturasSolLua(sky)
    end)
    local connMoon = sky:GetPropertyChangedSignal("MoonTextureId"):Connect(function()
        AplicarTexturasSolLua(sky)
    end)

    table.insert(_G.SkyConnections, connSun)
    table.insert(_G.SkyConnections, connMoon)
end

local function StartRain()
    local rainFolder = Instance.new("Folder", workspace)
    rainFolder.Name = "FakeRain"
    task.spawn(function()
        while _G.ShadersActive do
            for i = 1, 15 do
                if not _G.ShadersActive then break end
                local drop = Instance.new("Part", rainFolder)
                drop.Size = Vector3.new(0.1, 2, 0.1)
                drop.Anchored, drop.CanCollide = true, false
                drop.Material, drop.Transparency = Enum.Material.Glass, 0.5
                drop.Position = Vector3.new(math.random(-150,150), 100, math.random(-150,150))
                TweenService:Create(drop, TweenInfo.new(1), {Position = drop.Position - Vector3.new(0, 60, 0)}):Play()
                Debris:AddItem(drop, 1.1)
            end
            task.wait(1.5)
        end
    end)
end

local function ApplyCloudyShader()
    TotalReset()
    _G.ShadersActive = true

    Lighting.ClockTime = 12
    Lighting.Brightness = 2
    Lighting.OutdoorAmbient = Color3.fromRGB(50, 50, 50)
    Lighting.FogColor = Color3.fromRGB(120, 130, 140)
    Lighting.FogEnd = 500

    local color = Instance.new("ColorCorrectionEffect", Lighting)
    color.Contrast = 0.15
    color.Saturation = -0.1
    color.TintColor = Color3.fromRGB(220, 230, 255)

    local bloom = Instance.new("BloomEffect", Lighting)
    bloom.Intensity = 0.8
    bloom.Size = 56

    for _, part in pairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") and part.Material == Enum.Material.SmoothPlastic then
            part.Reflectance = 0.2
        end
    end

    Instance.new("Clouds", Terrain).Density = 0.9

    local currentSky = Lighting:FindFirstChildOfClass("Sky")
    if not currentSky then
        currentSky = Instance.new("Sky")
        currentSky.Parent = Lighting
    end
    MonitorarSolLua(currentSky)

    local skyAddedConn = Lighting.ChildAdded:Connect(function(child)
        if child:IsA("Sky") and _G.ShadersActive then
            task.wait()
            MonitorarSolLua(child)
        end
    end)
    table.insert(_G.SkyConnections, skyAddedConn)

    StartRain()
end

-- 6. SINCRONIZAÇÃO INICIAL DO ESTADO VISUAL
local function SyncVisualState()
    if _G.ShadersActive then
        ActionButton.Text = "REMOVER SHADERS"
        ActionButton.BackgroundColor3 = Color3.fromRGB(80, 20, 20)
        ActionStroke.Color = Color3.fromRGB(255, 80, 80)
    else
        ActionButton.Text = "APLICAR SHADERS"
        ActionButton.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
        ActionStroke.Color = Color3.fromRGB(200, 200, 200)
    end
end

