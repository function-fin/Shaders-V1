--- 5. FUNÇÕES DE LIMPEZA E SUPORTE (REMOÇÃO 100%) ---

local function TotalReset()
    _G.ShadersActive = false -- Para loops de chuva
    
    -- Limpa Lighting
    for _, obj in pairs(Lighting:GetChildren()) do
        if obj:IsA("PostEffect") or obj:IsA("Sky") or obj:IsA("Atmosphere") or obj.Name == "ULTRA_K_ORIGINAL" then
            obj:Destroy()
        end
    end
    
    -- Limpa Workspace (Chuva e Estrelas)
    if workspace:FindFirstChild("FakeRain") then workspace.FakeRain:Destroy() end
    if workspace:FindFirstChild("ShootingStars") then workspace.ShootingStars:Destroy() end
    
    -- Limpa Terrain
    for _, obj in pairs(Terrain:GetChildren()) do
        if obj:IsA("Clouds") then obj:Destroy() end
    end
    
    -- Reseta Materiais e Reflexos que o Ultra K altera
    for _, part in pairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") then
            if part.Material == Enum.Material.Basalt or part.Material == Enum.Material.Cobblestone then
                -- Tentativa de retornar ao padrão (apenas se tiver alterado)
            end
            part.Reflectance = 0 -- Reset de reflexo ultra
        end
    end
    
    -- Valores de Iluminação Padrão
    Lighting.ClockTime = 14
    Lighting.Brightness = 2
    Lighting.OutdoorAmbient = Color3.fromRGB(127, 127, 127)
    Lighting.FogEnd = 100000
    Lighting.ExposureCompensation = 0
    Terrain.WaterColor = Color3.fromRGB(12, 84, 92)
    Terrain.WaterReflectance = 1
    Terrain.WaterTransparency = 0.3
end

local function CreateButton(name, order, color)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.LayoutOrder = order
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.BackgroundColor3 = color or Color3.fromRGB(38, 38, 38) -- Preto Carbono
    btn.Text = name
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 12
    btn.Parent = ButtonContainer
    
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    local bStroke = Instance.new("UIStroke")
    bStroke.Thickness = 1
    bStroke.Color = Color3.fromRGB(60, 60, 60)
    bStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    bStroke.Parent = btn
    
    return btn
end

--- 6. LÓGICA DE CHUVA (MELHORIA CLOUDY) ---
local function StartRain()
    local rainFolder = Instance.new("Folder", workspace)
    rainFolder.Name = "FakeRain"
    task.spawn(function()
        while _G.ShadersActive do
            for i = 1, 15 do -- Quantidade otimizada para não dar lag
                if not _G.ShadersActive then break end
                local drop = Instance.new("Part", rainFolder)
                drop.Size = Vector3.new(0.1, 2, 0.1)
                drop.Anchored, drop.CanCollide = true, false
                drop.Material, drop.Transparency = Enum.Material.Glass, 0.5
                drop.Position = Vector3.new(math.random(-150,150), 100, math.random(-150,150))
                TweenService:Create(drop, TweenInfo.new(1), {Position = drop.Position - Vector3.new(0, 60, 0)}):Play()
                Debris:AddItem(drop, 1.1)
            end
            task.wait(1.5)
        end
    end)
end

